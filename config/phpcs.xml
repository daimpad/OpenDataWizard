<?xml version="1.0"?>
<ruleset name="OpenDataWizard">
	<description>WordPress Coding Standards for Open Data Wizard plugin.</description>

	<file>..</file>
	<exclude-pattern>../vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<rule ref="WordPress"/>

	<!-- File names follow the existing convention (class-fields.php etc.) -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>../includes/*</exclude-pattern>
	</rule>

	<!-- Meta key queries are intentional in this plugin -->
	<rule ref="WordPress.DB.SlowDBQuery">
		<exclude-pattern>../includes/*</exclude-pattern>
	</rule>

	<!-- serialize() is used only for cache keys, not user data -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_serialize">
		<exclude-pattern>../includes/class-rest-api.php</exclude-pattern>
	</rule>

	<!-- manage_open_data is a custom capability registered at activation (ODW_Setup) -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_open_data"/>
			</property>
		</properties>
	</rule>

	<!--
		The batch importer parses a locally-moved, is_uploaded_file()-validated upload.
		Direct fopen()/fgetcsv()/file_get_contents() are required here — WP_Filesystem
		offers no streaming CSV equivalent — so these specific sniffs are excluded for
		this file only.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fopen">
		<exclude-pattern>../includes/class-batch-import.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fclose">
		<exclude-pattern>../includes/class-batch-import.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>../includes/class-batch-import.php</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.AssignmentInCondition.FoundInWhileCondition">
		<exclude-pattern>../includes/class-batch-import.php</exclude-pattern>
	</rule>

	<!-- Test files: class name does not match filename (PSR-4 test naming) -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>../tests/*</exclude-pattern>
	</rule>

	<!-- Test stubs file legitimately defines multiple classes per file -->
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>../tests/*</exclude-pattern>
	</rule>

	<!-- Test stubs intentionally define duplicate class names (WP_Query, WP_CLI etc.) -->
	<rule ref="Generic.Classes.DuplicateClassName">
		<exclude-pattern>../tests/*</exclude-pattern>
	</rule>

	<!-- Test stub constructors intentionally accept but ignore args -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>../tests/*</exclude-pattern>
	</rule>

	<!--
		Tests laufen ohne WordPress: wp_delete_file(), WP_Filesystem und
		wp_parse_url() existieren dort nicht. Fixture-Dateien werden daher
		direkt geschrieben und gelöscht, und der wp_parse_url()-Mock muss
		parse_url() aufrufen — genau das ist ja die Verhaltensweise, die er
		nachbildet.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents">
		<exclude-pattern>../tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.unlink_unlink">
		<exclude-pattern>../tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.parse_url_parse_url">
		<exclude-pattern>../tests/*</exclude-pattern>
	</rule>

	<!-- CLI fixture generator: runs outside WordPress, the WP-Sniffs for output
	     and filesystem do not apply here. -->
	<exclude-pattern>../tests/shacl/*</exclude-pattern>
</ruleset>
