<?xml version="1.0"?>
<ruleset name="OpenDataWizard">
	<description>WordPress Coding Standards for Open Data Wizard plugin.</description>

	<file>..</file>
	<exclude-pattern>../vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<rule ref="WordPress"/>

	<!-- File names follow the existing convention (class-fields.php etc.) -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>../includes/*</exclude-pattern>
	</rule>

	<!-- Meta key queries are intentional in this plugin -->
	<rule ref="WordPress.DB.SlowDBQuery">
		<exclude-pattern>../includes/*</exclude-pattern>
	</rule>

	<!-- serialize() is used only for cache keys, not user data -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_serialize">
		<exclude-pattern>../includes/class-rest-api.php</exclude-pattern>
	</rule>

	<!-- Test files: class name does not match filename (PSR-4 test naming) -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>../tests/*</exclude-pattern>
	</rule>

	<!-- Test stubs file legitimately defines multiple classes per file -->
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>../tests/*</exclude-pattern>
	</rule>

	<!-- Test stubs intentionally define duplicate class names (WP_Query, WP_CLI etc.) -->
	<rule ref="Generic.Classes.DuplicateClassName">
		<exclude-pattern>../tests/*</exclude-pattern>
	</rule>

	<!-- Test stub constructors intentionally accept but ignore args -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>../tests/*</exclude-pattern>
	</rule>
</ruleset>
