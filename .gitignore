# Betriebssystem / Editor
.DS_Store
Thumbs.db
*.swp
*~

# Logs / temporäre Dateien
*.log
*.tmp

# Composer-Abhängigkeiten: NICHT committen.
# Sie werden reproduzierbar aus composer.lock erzeugt — lokal und in der CI per
# `composer install`, für das Release-ZIP per bin/build-release.sh (--no-dev).
# So kann vendor/ nicht mehr vom Lock abweichen (siehe CHANGELOG 2.34.0).
/vendor/

# Node (nur für E2E/Build; nicht committen)
node_modules/

# Playwright-Artefakte
/test-results/
/playwright-report/

# wp-env: lokale Abweichungen von .wp-env.json (eigene WP-Version, Ports)
.wp-env.override.json

# SHACL-Validierungs-Fixtures (generiert von tests/shacl/generate-fixtures.php)
/build/

# Release-Builds (bin/build-release.sh)
/dist/
__pycache__/
