{
  "name": "@piveau/dpi",
  "type": "module",
  "version": "0.1.0-beta.86",
  "private": false,
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": {
      "import": "./dist/assets/dpi.css",
      "default": "./dist/assets/dpi.css"
    },
    "./msw": {
      "types": "./dist/msw.d.ts",
      "import": "./dist/msw.js",
      "default": "./dist/msw.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "histoire dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "prepublishOnly": "vite build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@formkit/core": "^1.6.9",
    "@formkit/themes": "^1.6.9",
    "@formkit/utils": "^1.6.9",
    "@formkit/vue": "^1.6.9",
    "@headlessui/vue": "^1.7.23",
    "@histoire/plugin-vue": "1.0.0-alpha.2",
    "@phosphor-icons/vue": "^2.2.1",
    "@piveau/jsonld": "file:../../bin/piveau-jsonld-1.0.0-beta.29.tgz",
    "@popperjs/core": "^2.11.8",
    "@types/jsonld": "^1.5.15",
    "@types/node": "^24.1.0",
    "@vee-validate/zod": "^4.15.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/shared": "^3.5.18",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^10.11.1",
    "axios": "^1.11.0",
    "bootstrap": "^5.3.8",
    "dayjs": "^1.11.13",
    "eslint": "^9.31.0",
    "histoire": "1.0.0-alpha.2",
    "jiti": "^2.5.1",
    "jquery": "^3.7.1",
    "jsonld": "^8.3.3",
    "lodash-es": "^4.17.21",
    "msw": "^2.12.12",
    "qs": "^6.14.0",
    "sass": "^1.89.2",
    "typescript": "~5.8.3",
    "vee-validate": "^4.15.1",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plugin-static-copy": "^3.1.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.8",
    "vuex": "^4.1.0",
    "zod": "^4.0.8"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": ">=10.13.1",
        "onFail": "error"
      },
      {
        "name": "npm"
      }
    ]
